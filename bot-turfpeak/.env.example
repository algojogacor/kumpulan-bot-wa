# ==============================================================================
# Flash Peak TMS - Environment Configuration Template
# All secrets must remain as placeholders only in this file.
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Canonical Database (Turso / libSQL)
# For local development: file:local.sqlite
# For production Turso: libsql://[your-db].turso.io
TURSO_DATABASE_URL=file:local.sqlite
TURSO_AUTH_TOKEN=your_turso_auth_token_placeholder

# Tournament & Localization
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_TOURNAMENT_ID=

# WhatsApp (Baileys) Configuration
# Sockets and auth state are isolated outside business tables.
WA_AUTH_STATE_DIR=your_wa_auth_state_dir_here
WA_CENTRAL_GROUP_JID=120363000000000000@g.us
# WA_ORGANIZER_JID / WA_ORGANIZER_PHONE MUST be set to the real organizer identity.
# Startup aborts if neither is configured (no example value is provided on purpose).
# WA_ORGANIZER_JID=6280000000000@s.whatsapp.net
# WA_ORGANIZER_PHONE=6280000000000
WA_RECONNECT_MAX_RETRIES=10
WA_RECONNECT_BASE_DELAY_MS=2000

# Flash Peak Media Service (Dedicated instance, Verax pattern)
# Running separately on its own port and storage directory (D-021, D-022, O-011)
# NOTE: production (ecosystem.config.cjs) runs the media service on port 4189.
MEDIA_SERVICE_PORT=4189
MEDIA_SERVICE_URL=http://127.0.0.1:4189
MEDIA_SERVICE_HMAC_SECRET=your_media_service_hmac_secret_here
MEDIA_STORAGE_ROOT=./services/flashpeak-media/storage

# WhatsApp media intake guardrails (audit fix B-1)
# Download timeout per attachment (default 20000 ms)
# WA_MEDIA_DOWNLOAD_TIMEOUT_MS=20000
# Max attachment size in bytes (default 10 MB)
# WA_MEDIA_MAX_BYTES=10485760

# AI Vision & Extraction Providers (Free tier rotated / load balanced)
# Model names below were VALIDATED by direct test call against each provider
# endpoint from the production VM on 2026-11-22 (audit fix B-3). Do not change
# a model name without re-validating it the same way.
# 1. Groq
GROQ_API_KEY=gsk_your_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=qwen/qwen3.8-27b

# 2. Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3-flash-preview

# 3. DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash

# 4. NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 5. Cohere
COHERE_API_KEY=your_cohere_api_key_here
COHERE_VISION_MODEL=c4ai-aya-vision-32b
COHERE_TEXT_MODEL=command-a-reasoning-08-2025

# 6. Mistral
# B-3: pixtral-12b-2409 is RETIRED (absent from Mistral's /v1/models; calls are
# silently served by a different model than configured). ministral-14b-latest is
# the validated vision default on free-tier keys; mistral-medium-latest exists in
# the catalog but is persistent-429 on free keys (upgrade path with paid keys).
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_VISION_MODEL=ministral-14b-latest
MISTRAL_TEXT_MODEL=codestral-latest

# 7. Ollama Cloud (dormant fallback — inactive when base URL is unset)
OLLAMA_CLOUD_BASE_URL=https://ollama.cloud.example.com
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_VISION_MODEL=llama3.2-vision:latest

# Debounce & Intake Timing
DEBOUNCE_WINDOW_SECONDS=5
REPORT_SESSION_EXPIRY_MINUTES=10
REPORT_SESSION_MAX_EXTENSIONS=3

# AI Resilience: automatic retry queue (AllProvidersFailedError only)
# Max automatic retries per evidence batch (default 3 -> 4 total attempts)
AI_MAX_RETRIES=3
# Delay before each retry attempt in ms (default 60000, aligned with circuit-breaker cooldown)
AI_RETRY_DELAY_MS=60000

# Feature Flags / Competition Rule Toggles
# Suspends goalkeeper detail screenshot requirement and goalkeeper awards during tournament
SUSPEND_GOALKEEPER=false

