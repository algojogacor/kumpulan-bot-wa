{
  "name": "flash-peak-tms",
  "version": "0.1.0",
  "description": "WhatsApp-first Tournament Management System for Flash Peak",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/cli/start.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/data', { recursive: true }); for (const f of fs.readdirSync('src/data')) if (f.endsWith('.json')) fs.copyFileSync('src/data/' + f, 'dist/data/' + f); })\"",
    "test": "vitest run",
    "lint": "eslint src",
    "migrate": "tsx src/db/migrate.ts",
    "reset-data": "tsx src/cli/reset_data.ts"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.3",
    "@libsql/client": "^0.18.0",
    "@whiskeysockets/baileys": "6.7.24",
    "fastest-levenshtein": "^1.0.16",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
