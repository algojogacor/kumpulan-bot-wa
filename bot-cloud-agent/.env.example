# LLM Providers
# Primary: DeepSeek
DEEPSEEK_API_KEY_1=your_deepseek_api_key_1_here
DEEPSEEK_API_KEY_2=your_deepseek_api_key_2_here
DEEPSEEK_API_KEY_3=your_deepseek_api_key_3_here
DEEPSEEK_API_KEY_4=your_deepseek_api_key_4_here
DEEPSEEK_API_KEY_5=your_deepseek_api_key_5_here

# Perplexity
PERPLEXITY_API_KEY_1=pplx-your_api_key_here
PERPLEXITY_API_KEY_2=pplx-your_api_key_here

# Fallback providers
GROQ_API_KEY=your_groq_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# Optional MCP integrations
BRAVE_API_KEY=your_brave_api_key_here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Supabase
# Used for persisting the whole nanobot workspace in Storage, including WhatsApp auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=nanobot-private
SUPABASE_WORKSPACE_OBJECT=nanobot/workspace.zip
SUPABASE_SYNC_ROOT=/app/data
SUPABASE_SYNC_INTERVAL_SECONDS=300

# Optional for future Postgres-backed features or your own app code.
# If Koyeb cannot use the direct IPv6 connection, use the Supabase Session Pooler URI instead.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Nanobot
NANOBOT_WORKSPACE=/home/nanobot/.nanobot
